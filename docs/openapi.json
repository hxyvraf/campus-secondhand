{"openapi":"3.0.1","info":{"title":"校园二手交易平台 API","description":"B/S 架构校园二手交易平台后端接口，包含注册登录、商品发布与管理、搜索收藏、订单管理、消息通知 5 个模块及管理端接口。除白名单接口外均需在请求头携带 Authorization: Bearer {token}。","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"09-管理端","description":"商品管理、用户管理、分类维护、订单超时扫描（均需管理员账号 admin）"},{"name":"01-认证","description":"注册、登录、退出、当前用户、修改密码"},{"name":"02-用户","description":"用户公开主页、个人资料维护"},{"name":"08-消息","description":"站内消息列表、未读数、标记已读"},{"name":"05-文件","description":"商品图片上传"},{"name":"03-分类","description":"分类列表（管理端的分类维护接口见「06-管理端」）"},{"name":"06-收藏","description":"收藏、取消收藏、我的收藏"},{"name":"04-商品","description":"发布、搜索、详情、编辑、上下架、删除、我发布的商品"},{"name":"07-订单","description":"下单、订单列表、订单详情、卖家确认、买家完成、取消订单"}],"paths":{"/api/users/me":{"put":{"tags":["02-用户"],"summary":"更新个人资料","description":"登录后可修改昵称、手机号、邮箱、头像、学校","operationId":"updateProfile","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProfileRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}}},"/api/products/{id}":{"get":{"tags":["04-商品"],"summary":"商品详情","description":"匿名可访问；返回图片列表与当前登录用户是否已收藏；每次调用浏览量 +1；商品不存在返回 404/40401","operationId":"detail","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultProductVO"}}}}}},"put":{"tags":["04-商品"],"summary":"编辑商品","description":"仅发布者本人可编辑，非本人返回 403/40301；交易中或已售出商品不可编辑，返回 409/40902","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductSaveRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}},"delete":{"tags":["04-商品"],"summary":"删除商品","description":"逻辑删除，仅本人可删除；交易中的商品不可删除，返回 409/40902","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/messages/{id}/read":{"put":{"tags":["08-消息"],"summary":"标记单条消息为已读","description":"只能操作自己的消息，他人消息返回 403/40301；消息不存在返回 404/40401","operationId":"markRead","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/messages/read-all":{"put":{"tags":["08-消息"],"summary":"全部标记为已读","description":"返回本次更新的条数","operationId":"markAllRead","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultMapStringInteger"}}}}}}},"/api/auth/password":{"put":{"tags":["01-认证"],"summary":"修改密码","description":"原密码不正确返回 400/40001；新密码与原密码相同也返回 400/40001","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePasswordRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/admin/users/{id}/status":{"put":{"tags":["09-管理端"],"summary":"启用/禁用用户","description":"status=1 启用、0 禁用；不能修改自己或管理员的账号状态(403/40301)；被禁用的用户立即无法调用需要登录的接口(403/40302)","operationId":"updateUserStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserStatusRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}}},"/api/admin/products/{id}/off-shelf":{"put":{"tags":["09-管理端"],"summ